---
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { SITE, STORE } from '../config/site';
import { LAST_MODIFIED } from '../lib/buildInfo';
import { appStoreUrl, playStoreUrl } from '../lib/storeLinks';
import { LOCALES, DEFAULT_LOCALE, getLocale, localePath, t, type LocaleSlug } from '../i18n';
import { absoluteUrl, withBase } from '../lib/paths';

interface Props {
  locale: LocaleSlug;
  title: string;
  description: string;
  /** Page path without locale prefix, e.g. '' for home or 'privacy'. */
  page?: string;
  /** Emit hreflang alternates for every locale (only for pages that exist in all locales). */
  alternates?: boolean;
  noindex?: boolean;
  /** Extra JSON-LD objects for this page. */
  structuredData?: ReadonlyArray<Record<string, unknown>>;
  /** `@id` of the thing this page is about, e.g. the app. */
  about?: string;
  /** Site path of the share image. */
  image?: string;
  /** Alt text of the share image. */
  imageAlt?: string;
}

const {
  locale,
  title,
  description,
  page = '',
  alternates = false,
  noindex = false,
  structuredData = [],
  about,
  image = '/og/en.jpg',
  imageAlt = SITE.storeName,
} = Astro.props;
const def = getLocale(locale);
const dict = t(locale);
const canonical = absoluteUrl(localePath(locale, page), Astro.site);
const ogImage = absoluteUrl(image, Astro.site);
const siteRoot = absoluteUrl('/', Astro.site);
const storeListings = [appStoreUrl(STORE), ...(SITE.playEnabled ? [playStoreUrl(STORE)] : [])];

const graph = [
  {
    '@type': 'Organization',
    '@id': `${siteRoot}#org`,
    name: SITE.name,
    url: siteRoot,
    logo: absoluteUrl('/icons/icon-512.png', Astro.site),
    email: SITE.supportEmail,
    founder: { '@id': `${siteRoot}#founder` },
    // The store listings and social profiles that belong to this site.
    sameAs: [...storeListings, ...SITE.social.map((s) => s.url)],
  },
  {
    '@type': 'Person',
    '@id': `${siteRoot}#founder`,
    name: SITE.founder.name,
    jobTitle: 'Dancer and software engineer',
    sameAs: [SITE.founder.url],
  },
  {
    '@type': 'WebSite',
    '@id': `${siteRoot}#website`,
    name: SITE.name,
    url: siteRoot,
    inLanguage: LOCALES.map((l) => l.htmlLang),
    publisher: { '@id': `${siteRoot}#org` },
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    inLanguage: def.htmlLang,
    isPartOf: { '@id': `${siteRoot}#website` },
    ...(about ? { about: { '@id': about } } : {}),
    primaryImageOfPage: ogImage,
    dateModified: LAST_MODIFIED.toISOString(),
  },
  ...structuredData,
];
---

<!doctype html>
<html lang={def.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="content-language" content={def.htmlLang} />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    {
      alternates &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={l.htmlLang} href={absoluteUrl(localePath(l.slug, page), Astro.site)} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={absoluteUrl(localePath(DEFAULT_LOCALE, page), Astro.site)} />}

    <meta name="theme-color" content="#060708" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />

    <!-- Safari Smart App Banner: one-tap install, credited to this site as Web Referrer in App Store Connect. -->
    <meta name="apple-itunes-app" content={`app-id=${STORE.appStoreId}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content={def.ogLocale} />
    {alternates && LOCALES.filter((l) => l.slug !== locale).map((l) => <meta property="og:locale:alternate" content={l.ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />

    {
      SITE.cloudflareBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: SITE.cloudflareBeaconToken })}
        />
      )
    }
    {
      SITE.gaMeasurementId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`} />
          <script is:inline define:vars={{ id: SITE.gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() {
              window.dataLayer.push(arguments);
            };
            window.gtag('js', new Date());
            window.gtag('config', id, {
              allow_google_signals: false,
              allow_ad_personalization_signals: false,
            });
          </script>
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{dict.nav.skip}</a>
    <slot />
  </body>
</html>
