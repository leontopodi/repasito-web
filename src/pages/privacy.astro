---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import policy from '../content/privacy.html?raw';
import { DEFAULT_LOCALE } from '../i18n';

const locale = DEFAULT_LOCALE;
---

<BaseLayout
  locale={locale}
  page="privacy"
  title="Privacy Policy – RePasito"
  description="How RePasito for iPhone and Android, and the repasito.app website, handle your data.">
  <SiteHeader locale={locale} page="privacy" localized={false} />
  <main id="main" class="policy wrap">
    <h1>Privacy Policy</h1>
    <Fragment set:html={policy} />
  </main>
  <SiteFooter locale={locale} />
</BaseLayout>

<style>
  .policy {
    max-width: 46rem;
    padding-block: 2rem 5rem;
  }

  .policy h1 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }

  .policy :global(.lede) {
    font-size: var(--step-0);
    max-width: none;
    color: var(--haze);
  }

  .policy :global(section) {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.75rem;
  }

  .policy :global(h2) {
    font-size: var(--step-1);
    font-stretch: 108%;
  }

  .policy :global(p) {
    color: var(--haze);
  }

  .policy :global(a) {
    color: var(--chalk);
  }
</style>
