---
import type { GetStaticPaths } from 'astro';
import InvitePage from '../../components/InvitePage.astro';
import { DEFAULT_LOCALE, LOCALES, type LocaleSlug } from '../../i18n';
export const getStaticPaths = (() => LOCALES.filter((l) => l.slug !== DEFAULT_LOCALE).map((l) => ({ params: { lang: l.slug } }))) satisfies GetStaticPaths;
const locale = Astro.params.lang as LocaleSlug;
---
<InvitePage locale={locale} />
