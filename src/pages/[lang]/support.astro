---
import type { GetStaticPaths } from 'astro';
import SupportPage from '../../components/SupportPage.astro';
import { DEFAULT_LOCALE, LOCALES, type LocaleSlug } from '../../i18n';

export const getStaticPaths = (() =>
  LOCALES.filter((l) => l.slug !== DEFAULT_LOCALE).map((l) => ({ params: { lang: l.slug } }))) satisfies GetStaticPaths;

const locale = Astro.params.lang as LocaleSlug;
---

<SupportPage locale={locale} />
