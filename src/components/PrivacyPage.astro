---
/** The privacy policy in one language. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { SITE } from '../config/site';
import { t, type LocaleSlug } from '../i18n';
import { privacyPolicy } from '../lib/privacyPolicy';

interface Props {
  locale: LocaleSlug;
}

const { locale } = Astro.props;
const d = t(locale);
---

<BaseLayout
  locale={locale}
  page="privacy"
  alternates
  title={`${d.privacy.title} – ${SITE.name}`}
  description={d.privacy.description}
  image={`/og/${locale}.jpg`}
  imageAlt={d.meta.storeName}>
  <SiteHeader locale={locale} page="privacy" />
  <main id="main" class="policy wrap">
    <h1>{d.privacy.title}</h1>
    <Fragment set:html={privacyPolicy(locale)} />
  </main>
  <SiteFooter locale={locale} page="privacy" />
</BaseLayout>

<style>
  .policy {
    max-width: 46rem;
    padding-block: 2rem 5rem;
  }

  .policy h1 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }

  .policy :global(.lede) {
    font-size: var(--step-0);
    max-width: none;
    color: var(--haze);
  }

  .policy :global(.note) {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-s);
    font-size: var(--step--1);
    color: var(--haze);
  }

  .policy :global(section) {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.75rem;
  }

  .policy :global(h2) {
    font-size: var(--step-1);
    font-stretch: 108%;
  }

  .policy :global(p) {
    color: var(--haze);
  }

  .policy :global(a) {
    color: var(--chalk);
  }
</style>
