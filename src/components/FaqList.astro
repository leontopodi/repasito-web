---
/** Questions and answers as native disclosure widgets. */
import Phrased from './Phrased.astro';
import type { LocaleSlug } from '../i18n';

interface Props {
  items: ReadonlyArray<{ q: string; a: string }>;
  locale: LocaleSlug;
}

const { items, locale } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details>
        <summary><span><Phrased text={item.q} locale={locale} /></span></summary>
        <p class="muted">{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    max-width: 52rem;
  }

  details {
    border-top: 1px solid var(--rule);
  }

  details:last-child {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.1rem;
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.3;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    flex: none;
    font-weight: 400;
    color: var(--haze);
    transition: rotate 160ms ease;
  }

  details[open] summary::after {
    rotate: 45deg;
  }

  details p {
    padding-bottom: 1.25rem;
    max-width: var(--measure);
  }
</style>
