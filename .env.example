# Public origin and base path (CI sets these from the GitHub Pages configuration).
SITE_URL=https://repasito.app
BASE_PATH=/

# Apple provider token from App Store Connect → Analytics → Campaigns → Generate a campaign link.
# When set, App Store links carry pt/ct campaign parameters.
PUBLIC_APPLE_PROVIDER_TOKEN=

# GA4 measurement ID (G-XXXXXXXXXX). Leave empty to run without analytics or cookies.
PUBLIC_GA_MEASUREMENT_ID=

# Set to false to hide the Google Play badge and Android copy.
PUBLIC_PLAY_ENABLED=true
